# FreightTiger Case Study - Environment Variables Template
# Copy this file to .env to configure live LLM access if desired.
# NOTE: DO NOT commit your actual .env file or API keys to version control.

# Execution mode: 'offline' (default, no API key needed), 'openai', 'groq', 'gemini', or 'ollama'
LLM_PROVIDER=offline

# Model identifier
LLM_MODEL=default

# Provider Credentials (only needed if LLM_PROVIDER is not 'offline')
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Threshold overrides (optional)
HISTORY_THRESHOLD=20.0
PEER_THRESHOLD=20.0
